{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["@mtcute/bun"]
    },
    "apps/backend": {
      "entry": [
        "tests/**/*.test.ts",
        "src/runtime/config-check.ts",
        "src/story-cards/renderer-process.ts",
        "src/studio/services/index.ts",
        "src/runtime/server.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
