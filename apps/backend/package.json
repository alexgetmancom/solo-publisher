{
  "name": "@solo-publisher/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch ../../apps/web/server.ts",
    "build": "bun build src/cli.ts --outdir dist --target bun --splitting --minify --sourcemap=external",
    "start": "bun --smol ../../apps/web/server.ts",
    "ops": "bun src/cli.ts",
    "docker-entrypoint": "bun src/runtime/docker-entrypoint.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test tests/*.test.ts",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/runner": "^2.0.3",
    "@mtcute/bun": "^0.32.0",
    "@mtcute/core": "^0.31.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "grammy": "^1.45.1",
    "hono": "^4.13.1",
    "p-limit": "^7.3.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
