---
import { THEME_BOOT_SCRIPT, THEME_TOGGLE_SCRIPT } from "../../../../shared/theme-script.js";
import { stripLeadingEmojis } from "../../../backend/src/content/text.js";
import { BRAND_ASSET_VERSION } from "../utils/brand";
import { siteUrlFromContext } from "../utils/site";
import "../styles/layout.css";

interface Props {
  title?: string;
  description?: string;
  schema?: string;
  canonicalUrl?: string;
  lang?: string;
  siteName?: string;
  rssHref?: string;
  alternateLinks?: Array<{ hreflang: string; href: string }>;
  robots?: string;
  socialImage?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  ogType?: string;
  immersiveHome?: boolean;
}

const {
  title = "Алекс Гетман | Сливы и новости ИИ",
  description = "Алекс Гетман пишет об AI, разработке, автоматизации, self-hosted системах и инструментах для разработчиков.",
  schema,
  canonicalUrl = Astro.url.href,
  lang = "ru",
  siteName = "Алекс Гетман",
  rssHref = "/feed.xml",
  alternateLinks = [],
  robots = "index, follow",
  socialImage: socialImageProp,
  socialImageWidth = 500,
  socialImageHeight = 500,
  ogType = "website",
  immersiveHome = false,
} = Astro.props;

const cleanDescription = stripLeadingEmojis(description);
// This install's own origin. A hardcoded one puts another site's address in
// every canonical link, hreflang and social card a self-hosted Studio renders,
// which tells search engines its pages belong to that other site.
const publicBaseUrl = siteUrlFromContext(Astro);
// Optional external analytics. Unset means no third-party script at all: a
// self-hosted Studio must not report its visitors to whoever published the
// image, and shipping a live endpoint here did exactly that.
const analyticsSdkUrl = Bun.env.WEB_ANALYTICS_SDK_URL?.trim();
const analyticsWebsiteId = Bun.env.WEB_ANALYTICS_WEBSITE_ID?.trim();
const analyticsEnabled = Boolean(analyticsSdkUrl && analyticsWebsiteId);
const socialImage = socialImageProp
  ? socialImageProp.startsWith("http")
    ? socialImageProp
    : `${publicBaseUrl}${socialImageProp.startsWith("/") ? socialImageProp : `/${socialImageProp}`}`
  : `${publicBaseUrl}/brand-social-20260629.jpg`;
const twitterCard = socialImageWidth >= 1000 ? "summary_large_image" : "summary";
const safeSchema = schema?.replace(/</g, "\\u003c").replace(/>/g, "\\u003e").replace(/&/g, "\\u0026");
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={cleanDescription} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#080B10" />
    <script is:inline set:html={THEME_BOOT_SCRIPT}></script>
    {analyticsEnabled && (<>
    <script is:inline>
      window.Fusionaly = window.Fusionaly || {};
      window.Fusionaly.config = {
        autoInstrumentButtons: false,
        autoSendPageViews: true,
        respectDoNotTrack: true,
        debug: false,
      };
    </script>
    <script defer src={analyticsSdkUrl} data-website-id={analyticsWebsiteId}></script>
    </>)}
    <link rel="icon" type="image/png" href="/brand-favicon-20260629.png" />
    <link rel="apple-touch-icon" href="/brand-favicon-20260629.png" />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${BRAND_ASSET_VERSION}`} />
    <link rel="alternate icon" type="image/x-icon" href={`/favicon.ico?v=${BRAND_ASSET_VERSION}`} />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={title} href={rssHref} />
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <link rel="api-catalog" type="application/linkset+json" href="/.well-known/api-catalog" />
    <link rel="agent-skills" type="application/json" href="/.well-known/agent-skills/index.json" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title.split(" | ")[0]} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title.split(" | ")[0]} />
    <meta name="twitter:description" content={cleanDescription} />
    <meta name="twitter:image" content={socialImage} />
    {safeSchema && <script type="application/ld+json" set:html={safeSchema}></script>}
    <script is:inline>
      (() => {
        const registerWebMCP = async () => {
          if (!navigator.modelContext) return;
          try {
            const provideContext = navigator.modelContext.provideContext || navigator.modelContext.registerTool;
            if (typeof provideContext !== "function") return;
            const tool = {
              name: "read_feed",
              description: "Get the latest AI news, automation notes and developer updates from alexgetman.com.",
              inputSchema: { type: "object", properties: { limit: { type: "number", description: "Number of posts to return (default 5, max 12)" } } },
              execute: async (args) => {
                try {
                  const response = await fetch("/feed.json");
                  const data = await response.json();
                  return { result: (data.items || data).slice(0, args.limit || 5) };
                } catch (error) {
                  return { error: error instanceof Error ? error.message : String(error) };
                }
              },
            };
            if (navigator.modelContext.provideContext) await navigator.modelContext.provideContext({ tools: [tool] });
            else await navigator.modelContext.registerTool(tool, tool.execute);
          } catch {}
        };
        registerWebMCP();
      })();
    </script>
  </head>
  <body class={immersiveHome ? "immersive-home" : undefined}>
    <a class="skip-link" href="#main-content">{lang === "ru" ? "К содержанию" : "Skip to content"}</a>
    <button
      type="button"
      class="theme-toggle"
      data-theme-toggle
      aria-label={lang === "ru" ? "Переключить тему" : "Toggle theme"}
    >
      <svg class="theme-toggle__icon theme-toggle__icon--system" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2.5" y="4" width="19" height="13" rx="2"></rect>
        <path d="M9 21h6M12 17v4"></path>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
    <main class="container" id="main-content" tabindex="-1"><slot /></main>
    <script>
      import "../scripts/site-interactions.ts";
    </script>
    <script is:inline set:html={THEME_TOGGLE_SCRIPT}></script>
  </body>
</html>
