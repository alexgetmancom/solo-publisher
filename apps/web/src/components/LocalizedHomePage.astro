---
import { homePageSize } from "../features/story-player/config";
import { watchedCutoffFor } from "../features/story-player/payload";
import Layout from "../layouts/Layout.astro";
import { loadFeedItems } from "../server/public-site";
import { siteCopy } from "../server/site-copy";
import { sortedHomePosts } from "../utils/home-posts";
import HomeNewsPage from "./HomeNewsPage.astro";

type Props = { locale: "en" | "ru" };

import { siteUrlFromContext } from "../utils/site";

const siteOrigin = siteUrlFromContext(Astro);
const { locale } = Astro.props;
const russian = locale === "ru";
const allPosts = sortedHomePosts(loadFeedItems(), locale);
/* Only the first page is serialized into the island's props -- the whole feed
   was most of this page's HTML. The player fetches the rest from
   /home-posts.json as the reader approaches the end of what it has. */
const posts = allPosts.slice(0, homePageSize);
const title = russian ? "Алекс Гетман — новости ИИ, моделей и AI-продуктов" : "Alex Getman — AI news, models and product updates";
const description = russian
  ? "Свежие новости ИИ: новые модели, продукты и обновления OpenAI, ChatGPT Codex, Claude, Gemini и других. Релизы, тесты, цены, лимиты и комментарии."
  : "Fresh AI news on new models, product updates and releases from OpenAI, ChatGPT Codex, Claude, Gemini and more — with benchmarks, pricing, limits and commentary.";
const siteName = russian ? "Алекс Гетман" : "Alex Getman";
const canonicalUrl = russian ? `${siteOrigin}/ru/` : `${siteOrigin}/`;
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteOrigin}/#person`,
      name: siteName,
      ...(russian ? { alternateName: "Alex Getman" } : {}),
      url: canonicalUrl,
      image: `${siteOrigin}/avatar.png`,
      sameAs: siteCopy(locale).social.map(([, url]) => url),
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      url: canonicalUrl,
      name: siteName,
      description,
      inLanguage: russian ? "ru-RU" : "en-US",
      publisher: { "@id": `${siteOrigin}/#person` },
    },
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#home`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: russian ? "ru-RU" : "en-US",
      isPartOf: { "@id": `${siteOrigin}/#website` },
    },
  ],
});
---

<Layout
  title={title}
  description={description}
  schema={schema}
  canonicalUrl={canonicalUrl}
  lang={locale}
  siteName={siteName}
  rssHref={russian ? "/ru/feed.xml" : "/feed.xml"}
  socialImage="/social-image-wide.jpg"
  socialImageWidth={1200}
  socialImageHeight={630}
  alternateLinks={[
    { hreflang: "en", href: `${siteOrigin}/` },
    { hreflang: "ru", href: `${siteOrigin}/ru/` },
    { hreflang: "x-default", href: `${siteOrigin}/` },
  ]}
  immersiveHome
>
  <HomeNewsPage posts={posts} total={allPosts.length} watchedCutoff={watchedCutoffFor(allPosts)} labels={{ empty: russian ? "Русские посты появятся здесь после публикации." : "English posts will appear here after publication approval." }} locale={locale} />
</Layout>
