---
import { storyUi } from "../features/story-player/i18n";
import { toPlayerPosts } from "../features/story-player/payload";
/* =============================================================================
 * ASTRO WRAPPER AROUND THE PLAYER (the SEO layer). The player itself is in
 * features/story-player/.
 * -----------------------------------------------------------------------------
 * What THIS file is responsible for, and nothing else:
 *   1. Post order: the selected post (an article page) comes first.
 *   2. SEO: the noscript fallback for clients without JS — the title (as a
 *      <p>; the page's only <h1> is rendered by the hydrated
 *      StoryContext.svelte), the active post's media and the full text.
 *   3. Performance: <link rel="preload"> for the first image/poster.
 *   4. Mounting the Svelte island <StoryPlayer client:load> (SSR-first).
 *
 * Interaction, state and player styling do NOT belong here: see
 * features/story-player/README.md. Do not add player markup in this file.
 * ========================================================================== */
import StoryPlayer from "../features/story-player/StoryPlayer.svelte";
import "../styles/home-news-page.css";
import type { HomeLabels, HomePost } from "./home-news/types";

interface Props {
  posts: HomePost[];
  labels: HomeLabels;
  locale: "en" | "ru";
  initialPostId?: number | string;
  initialPaused?: boolean;
  /** How many posts the feed has in total, when this page sends the player only
   * the first of them. Absent means these are all there are. */
  total?: number;
  /** The whole feed's "watched" cutoff, for the same reason. */
  watchedCutoff?: number;
}

const { posts, labels, locale, initialPostId, initialPaused = false, total, watchedCutoff } = Astro.props;

const selectedPost = initialPostId ? posts.find((post) => String(post.id) === String(initialPostId)) : null;
const storyPosts = selectedPost ? [selectedPost, ...posts.filter((post) => String(post.id) !== String(selectedPost.id))] : posts;
const playerPosts = toPlayerPosts(storyPosts, watchedCutoff);
const activePost = playerPosts[0] || null;
const ui = storyUi(locale);
---

<main class="home-page">
  {activePost ? (
    <>
      {activePost.mediaType !== 'video' && activePost.image && (
        <link rel="preload" as="image" href={activePost.image} imagesrcset={activePost.imageSrcSet || undefined} imagesizes="(max-width: 760px) min(100vw - 2rem, 390px), 320px" fetchpriority="high" />
      )}
      {activePost.mediaType === 'video' && (activePost.posterSrc || activePost.fallbackImage) && (
        <link rel="preload" as="image" href={activePost.posterSrc || activePost.fallbackImage} fetchpriority="high" />
      )}
      <StoryPlayer client:load posts={playerPosts} total={total ?? playerPosts.length} ui={ui} locale={locale} initialPaused={initialPaused} />
      <noscript>
        <article class="story-seo-content">
          <p class="story-seo-title">{activePost.title}</p>
          {activePost.mediaType === 'video' && activePost.image ? (
            <video src={activePost.image} poster={activePost.posterSrc || activePost.fallbackImage || undefined} controls muted playsinline></video>
          ) : activePost.image ? (
            <img src={activePost.image} alt={activePost.title} />
          ) : null}
          {activePost.fullBody.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </article>
      </noscript>
    </>
  ) : (
    <p class="empty">{labels.empty}</p>
  )}
</main>
