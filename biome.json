{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!dist",
      "!**/dist",
      "!runtime",
      "!ops",
      "!entrypoint",
      "!coverage",
      "!**/coverage",
      "!apps/backend/data",
      "!apps/backend/bot-api-data",
      "!apps/backend/bot-api-temp",
      "!apps/backend/drizzle"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  }
}
