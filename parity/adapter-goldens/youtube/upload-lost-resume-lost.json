    "credentials": {
      "X_ACCESS_TOKEN": "test-token-x",
      "X_REFRESH_TOKEN": "test-token-x-refresh",
      "ZERNIO_API_KEY": "test-token-zernio",
      "DISCORD_BOT_TOKEN": "test-token-discord"
