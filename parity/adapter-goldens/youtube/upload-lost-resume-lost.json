  },
  "files": {
    "photo.jpg": {
      "fill": "J",
      "size": 64
    },
    "second.png": {
      "fill": "P",
      "size": 48
    },
    "clip.mp4": {
      "fill": "V",
      "size": 96
    },
    "big.mp4": {
      "fill": "B",
      "size": 2101248
    },
    "upload.mp4": {
      "fill": "U",
      "size": 32
    },
    "story.jpg": {
      "fill": "S",
      "size": 40
    }
  },
  "responses": [
    {
      "status": 200,
      "headers": [["content-type", "application/json"]],
      "body": "{\"access_token\":\"test-token-youtube-access\",\"expires_in\":3599}"
    },
    {
      "status": 200,
      "headers": [["location", "https://upload.example/session/1?upload_id=u1"]]
    },
    {
      "throws": "connection reset by peer"
    },
    {
      "status": 308,
      "headers": [["range", "bytes=0-9"]]
    },
    {
      "throws": "connection reset by peer"
    }
  ],
  "requests": [
    {
      "method": "POST",
      "url": "https://oauth2.googleapis.com/token",
      "headers": [["content-type", "application/x-www-form-urlencoded;charset=UTF-8"]],
      "body": {
        "text": "client_id=test-youtube-ru-client&client_secret={{YOUTUBE_RU_CLIENT_SECRET}}&refresh_token={{YOUTUBE_RU_REFRESH_TOKEN}}&grant_type=refresh_token"
      }
    },
    {
      "method": "POST",
      "url": "https://www.googleapis.com/upload/youtube/v3/videos?uploadType=resumable&part=snippet,status,recordingDetails",
      "headers": [
        ["authorization", "Bearer test-token-youtube-access"],
        ["content-type", "application/json; charset=utf-8"],
        ["x-upload-content-length", "32"],
        ["x-upload-content-type", "video/mp4"]
      ],
      "body": {
        "text": "{\"snippet\":{\"title\":\"Title\",\"description\":\"Body\",\"tags\":[\"a\",\"b\"],\"categoryId\":\"20\",\"defaultLanguage\":\"ru\",\"defaultAudioLanguage\":\"ru\"},\"status\":{\"privacyStatus\":\"private\",\"publishAt\":\"2026-12-01T10:00:00.000Z\",\"selfDeclaredMadeForKids\":false},\"recordingDetails\":{\"recordingDate\":\"2026-12-01T10:00:00.000Z\"}}"
      }
    },
    {
      "method": "PUT",
      "url": "https://upload.example/session/1?upload_id=u1",
      "headers": [["content-length", "32"], ["content-range", "bytes 0-31/32"], ["content-type", "video/mp4"]],
      "body": {
        "text": "UUUUUUUUUUUUUUUUUUUUUUUUUUUUUUUU"
      }
    },
    {
      "method": "PUT",
      "url": "https://upload.example/session/1?upload_id=u1",
      "headers": [["content-length", "0"], ["content-range", "bytes */32"]],
      "body": {
        "text": ""
      }
    },
    {
      "method": "PUT",
      "url": "https://upload.example/session/1?upload_id=u1",
      "headers": [["content-length", "22"], ["content-range", "bytes 10-31/32"], ["content-type", "video/mp4"]],
      "body": {
        "text": "UUUUUUUUUUUUUUUUUUUUUU"
      }
    }
  ],
  "sleptMs": 0,
  "written": {},
  "outcome": {
    "error": {
      "kind": "ambiguous",
      "message": "verification_required: youtube_upload may have published before confirmation was lost: PUT https://upload.example/session/1?upload_id=u1 failed before receiving an HTTP response",
      "class": "unknown",
      "provider": "youtube_upload"
    }
  }
}
