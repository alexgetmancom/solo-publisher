{
  "name": "thread-rich-message",
  "operation": "adapter.publish",
  "inputs": {
    "target": "telegram",
    "payload": {
      "text": "First <part> & more",
      "entities": [
        {
          "type": "bold",
          "offset": 0,
          "length": 5
        }
      ],
      "media": [
        {
          "type": "IMAGE",
          "fileId": "lead"
        }
      ],
      "thread": [
        {
          "text": "Second",
          "entities": [
            {
              "type": "spoiler",
              "offset": 0,
              "length": 6
            }
          ],
          "media": [
            {
              "type": "VIDEO",
              "localPath": "$FILES/clip.mp4"
            }
          ]
        },
        {
          "text": "  ",
          "entities": [],
          "media": [
            {
              "type": "IMAGE",
              "vpsUrl": "https://media.example/c.jpg"
            }
          ]
        },
        {
          "text": "Last",
          "entities": [
            {
              "type": "text_link",
              "offset": 0,
              "length": 4,
              "url": "https://example.com"
            }
          ],
          "media": []
        }
      ]
    }
  },
  "config": {
    "env": {
      "DATA_DIR": "/data",
      "CONTROLLER_BOT_TOKEN": "test-token-telegram",
      "TELEGRAM_API_BASE_URL": "https://bot-api.example/",
      "TELEGRAM_CHANNEL_USERNAME": "@studiochannel",
      "THREADS_RU_ACCESS_TOKEN": "test-token-threads-ru",
      "THREADS_EN_ACCESS_TOKEN": "test-token-threads-en",
      "X_CLIENT_ID": "test-x-client",
      "X_CLIENT_SECRET": "test-secret-x-client",
      "DISCORD_CHANNEL_ID": "555",
      "DISCORD_GUILD_ID": "777",
      "INSTAGRAM_RU_ACCESS_TOKEN": "EAtest-token-instagram-ru",
      "INSTAGRAM_RU_USER_ID": "ig-ru-user",
      "INSTAGRAM_EN_ACCESS_TOKEN": "IGtest-token-instagram-en",
      "INSTAGRAM_EN_USER_ID": "ig-en-user",
      "YOUTUBE_RU_CLIENT_ID": "test-youtube-ru-client",
      "YOUTUBE_RU_CLIENT_SECRET": "test-secret-youtube-ru",
      "YOUTUBE_RU_REFRESH_TOKEN": "test-token-youtube-ru-refresh",
      "YOUTUBE_EN_CLIENT_ID": "test-youtube-en-client",
      "YOUTUBE_EN_CLIENT_SECRET": "test-secret-youtube-en",
      "YOUTUBE_EN_REFRESH_TOKEN": "test-token-youtube-en-refresh",
      "MEDIA_PROCESSOR_URL": "https://media-processor.example/",
      "MEDIA_PROCESSOR_TOKEN": "test-token-media-processor-000000000000"
    },
    "credentials": {
      "X_ACCESS_TOKEN": "test-token-x",
      "X_REFRESH_TOKEN": "test-token-x-refresh",
      "ZERNIO_API_KEY": "test-token-zernio",
      "DISCORD_BOT_TOKEN": "test-token-discord"
    }
  },
  "files": {
    "photo.jpg": {
      "fill": "J",
      "size": 64
    },
    "second.png": {
      "fill": "P",
      "size": 48
    },
    "clip.mp4": {
      "fill": "V",
      "size": 96
    },
    "big.mp4": {
      "fill": "B",
      "size": 2101248
    },
    "upload.mp4": {
      "fill": "U",
      "size": 32
    },
    "story.jpg": {
      "fill": "S",
      "size": 40
    }
  },
  "responses": [
    {
      "status": 200,
      "headers": [["content-type", "application/json"]],
      "body": "{\"ok\":true,\"result\":{\"message_id\":57}}"
    },
    {
      "status": 200,
      "headers": [["content-type", "application/json"]],
      "body": "{\"ok\":true,\"result\":true}"
    }
  ],
  "requests": [
    {
      "method": "POST",
      "url": "https://bot-api.example/bot{{CONTROLLER_BOT_TOKEN}}/sendRichMessage",
      "headers": [["content-type", "multipart/form-data"]],
      "body": {
        "parts": [
          {
            "headers": ["Content-Disposition: form-data; name=\"chat_id\""],
            "text": "@studiochannel"
          },
          {
            "headers": ["Content-Disposition: form-data; name=\"rich_message\""],
            "text": "{\"html\":\"<p><strong>First</strong> &lt;part&gt; &amp; more</p><img src=\\\"tg://photo?id=m1\\\"/><p><tg-spoiler>Second</tg-spoiler></p><video src=\\\"tg://video?id=m2\\\"></video><img src=\\\"tg://photo?id=m3\\\"/><p><a href=\\\"https://example.com\\\">Last</a></p>\",\"media\":[{\"id\":\"m1\",\"media\":{\"type\":\"photo\",\"media\":\"lead\"}},{\"id\":\"m2\",\"media\":{\"type\":\"video\",\"media\":\"attach://rich-m2\"}},{\"id\":\"m3\",\"media\":{\"type\":\"photo\",\"media\":\"https://media.example/c.jpg\"}}]}"
          },
          {
            "headers": ["Content-Disposition: form-data; name=\"rich-m2\"; filename=\"clip.mp4\"", "Content-Type: video/mp4"],
            "text": "VVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV"
          }
        ]
      }
    },
    {
      "method": "POST",
      "url": "https://bot-api.example/bot{{CONTROLLER_BOT_TOKEN}}/setMessageReaction",
      "headers": [["content-type", "application/json"]],
      "body": {
        "text": "{\"chat_id\":\"@studiochannel\",\"message_id\":57,\"reaction\":[{\"type\":\"emoji\",\"emoji\":\"❤\"}],\"is_big\":false}"
      }
    }
  ],
  "sleptMs": 0,
  "written": {},
  "outcome": {
    "ok": {
      "ok": true,
      "id": 57,
      "ids": [57],
      "url": "https://t.me/studiochannel/57",
      "raw": {
        "ok": true,
        "result": {
          "message_id": 57
        }
      }
    }
  }
}
