{
  "name": "solo-publisher",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p deploy/tsconfig.json",
    "test": "bun test --coverage deploy scripts",
    "check:audit": "bun audit --audit-level=high"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.10",
    "typescript": "7.0.2"
  }
}
