# Copy to .env, fill DOMAIN and the two secrets, then `docker compose up -d`.
# Everything below the first section is optional: a Studio with none of it set
# serves its Command Center and publishes nothing. The public site is off until
# `studio-profile-set --site-enabled` is run inside the app container.

# The hostname this Studio answers on. Caddy requests a certificate for it, so
# it must already resolve to this machine.
DOMAIN=publisher.example.com

# Generate each of these with: openssl rand -hex 32
COMMAND_CENTER_TOKEN=
CLIENT_IP_HASH_SALT=
# Seals the Meta tokens this Studio renews for itself before storing them, so
# they are not readable in the daily backup. Set it if you publish natively to
# Instagram or Threads; without it those tokens are never renewed and you
# re-issue them by hand every 60 days.
TOKEN_ENCRYPTION_KEY=

# `latest` is whatever is currently running in production. To stay on one
# release, pin the commit it was built from — that tag never moves:
# ghcr.io/alexgetmancom/solo-publisher:<commit-sha>
# Published for linux/amd64 and linux/arm64, so this runs on an ARM VM or a
# Raspberry Pi without building anything.
SOLO_PUBLISHER_IMAGE=ghcr.io/alexgetmancom/solo-publisher:latest

# Where `backup` and `backup-media` write. The daily Telegram backup carries the
# database only; video, posters, story cards and site assets live on the app-data
# volume and are lost with it. Point this at storage that is not that volume —
# another disk, a mount, anything off this machine — and run
# `docker compose exec app bun /app/ops/cli.js backup-media` on a schedule.
# `doctor` fails until an archive newer than a week is there.

# --- Telegram -----------------------------------------------------------
# The private bot you author from, and the numeric Telegram user ids allowed to
# operate it. Without these the Studio has no chat interface.
CONTROLLER_BOT_TOKEN=
CONTROLLER_ADMIN_IDS=
# The channel this Studio publishes to. Required once you publish anything:
# there is deliberately no default, because a default would be someone else's
# channel.
TELEGRAM_CHANNEL_USERNAME=

# Telegram's public API refuses downloads over 50 MB, which is smaller than a
# short video. Running a local Bot API server raises the limit to 2 GB. Get the
# two values from https://my.telegram.org, then uncomment the profile line so
# the server starts with the rest of the stack.
# COMPOSE_PROFILES=telegram
# TELEGRAM_API_BASE_URL=http://bot-api:8081
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Agent access -------------------------------------------------------
# An MCP client (Codex, Claude Code) operates the Studio with this token, acting
# as the Studio actor with this id.
MCP_STUDIO_TOKEN=
MCP_STUDIO_ACTOR_ID=

# --- Publishing destinations -------------------------------------------
# Add only the ones you use. See apps/backend/secrets.env.example for the full
# set, including video, and run
# `docker compose exec app bun /app/ops/cli.js doctor` to see what each one needs.
X_CLIENT_ID=
X_CLIENT_SECRET=
# A Threads long-lived token expires 60 days after it is issued. Set
# TOKEN_ENCRYPTION_KEY above and this Studio renews it a month ahead on its own;
# without that key it lapses and publishing starts failing.
# Connect the account from Studio → Channels, which stores the token itself and
# leaves THREADS_EN_ACCESS_TOKEN below unused. It needs the app id and secret —
# the pair named "Threads App ID" and "Threads App secret", not the Meta app's
# own — and TOKEN_ENCRYPTION_KEY above, which signs the connect link.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_EN_ACCESS_TOKEN=
