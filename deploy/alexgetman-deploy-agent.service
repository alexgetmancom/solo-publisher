[Unit]
Description=AlexGetman immutable image deploy agent
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy
EnvironmentFile=/etc/alexgetman/deploy-agent.env
# Copied out of the image each deployment activates, when it changed
# (cargo xtask deploy-release); see deploy/README.md.
ExecStart=/home/deploy/bin/deploy-agent
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/alexgetman-deploy /home/deploy/alexgetman-runtime /home/deploy/maru /var/run/docker.sock

[Install]
WantedBy=multi-user.target
