STUDIO=maru
STUDIO_PUBLIC_BASE_URL=https://marux.ru
STUDIO_PORT=8789
STUDIO_CPUS=0.75
TELEGRAM_CHANNEL_USERNAME=marux_play
STUDIO_DATA_DIR_HOST=/home/deploy/maru/data
STUDIO_MEDIA_CACHE_DIR_HOST=/mnt/alex-media/maru/media-cache
STUDIO_VIDEO_MEDIA_DIR_HOST=/mnt/alex-media/maru/video-media
STUDIO_MEDIA_STAGING_DIR_HOST=/mnt/alex-media/maru/media-staging
STUDIO_SITE_MEDIA_DIR_HOST=/home/deploy/maru/site-media
STUDIO_GROK_DIR_HOST=/home/deploy/grok/maru
# The address a container reaches this host on. `host-gateway` resolves to the
# default bridge, not to the network the Studios are on, and the deploy agent
# binds the latter -- without this the bot's deploy buttons reach nothing.
DEPLOY_AGENT_HOST_GATEWAY=172.20.0.1
