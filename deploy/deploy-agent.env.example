# This file belongs on the host at /etc/alexgetman/deploy-agent.env and must be chmod 600.
DEPLOY_AGENT_TOKEN=
DEPLOY_AGENT_HOST=172.17.0.1
DEPLOY_AGENT_PORT=9899
DEPLOY_IMAGE_REPOSITORY=ghcr.io/alexgetmancom/solo-publisher
# Bounded retries for transient registry and remote-agent failures.
DEPLOY_RETRY_ATTEMPTS=3
DEPLOY_RETRY_BACKOFF_MS=5000
DEPLOY_RETRY_MAX_BACKOFF_MS=30000

# One independent, immutable deployment state per runtime. Each target has its
# own compose manifest, image env file, health endpoint and rollback history.
# A compose target runs `studio-entrypoint --check-config` in a new image before
# replacing its container; "configCheck":false skips that for an image without it.
DEPLOY_TARGETS_JSON={"alex":{"composeFile":"/home/deploy/alexgetman-runtime/compose.yaml","imageEnvFile":"/home/deploy/alexgetman-runtime/deploy-image.env","stateFile":"/var/lib/alexgetman-deploy/alex.json","healthUrl":"http://127.0.0.1:8788/readyz","container":"alexgetman-backend"},"maru":{"composeFile":"/home/deploy/maru/compose.yaml","imageEnvFile":"/home/deploy/maru/deploy-image.env","stateFile":"/var/lib/alexgetman-deploy/maru.json","healthUrl":"http://127.0.0.1:8789/readyz","container":"maru-backend"}}

# Optional remote workers are generic targets. The URL is ordinarily a
# loopback-only reverse-tunnel port; the worker's own agent performs pull,
# recreate, health-check and rollback, and is called without a target name
# (POST /v1/deploy), which an agent with one target takes as its own. CI writes
# artifactFile for each SHA.
# Add entries alongside the local targets above, e.g.
# "worker":{"stateFile":"/var/lib/alexgetman-deploy/worker.json","remoteUrl":"http://127.0.0.1:9098","remoteToken":"<separate-worker-token>","artifactFile":"/var/lib/alexgetman-deploy/media-processor-release.json","repository":"ghcr.io/<owner>/alexgetman-media-processor","allowInitialSeed":true}

# Reuse the controller bot only for deployment notifications. The bot callback is
# authenticated again against CONTROLLER_ADMIN_IDS before the Studio calls this agent.
# Every URL the agent calls is plain http:// (this host, or a tunnel to it).
DEPLOY_NOTIFICATION_BOT_TOKEN=
DEPLOY_NOTIFICATION_CHAT_ID=
DEPLOY_NOTIFICATION_API_BASE_URL=http://127.0.0.1:8081
