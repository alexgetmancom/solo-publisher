# Host-only configuration of the deploy agent on a remote media worker, at
# /etc/alexgetman/media-processor-deploy-agent.env (mode 0600). Paths and the
# target name are examples: rename them freely for an independent installation.
DEPLOY_AGENT_TOKEN=
DEPLOY_AGENT_HOST=127.0.0.1
DEPLOY_AGENT_PORT=9898
DEPLOY_IMAGE_REPOSITORY=ghcr.io/<owner>/alexgetman-media-processor
# Bounded retries for transient registry failures during image activation.
DEPLOY_RETRY_ATTEMPTS=3
DEPLOY_RETRY_BACKOFF_MS=5000
DEPLOY_RETRY_MAX_BACKOFF_MS=30000
# The worker's one target. The Studio host's agent calls POST /v1/deploy without
# a name, which an agent with a single target takes as that target. The
# processor image has no studio-entrypoint, hence "configCheck":false.
# "allowInitialSeed":true only for a migration from a hand-built worker; remove
# it after the first healthy immutable deployment, when a real rollback exists.
DEPLOY_TARGETS_JSON={"media":{"composeFile":"/opt/alexgetman-media-processor/compose.yml","imageEnvFile":"/opt/alexgetman-media-processor/.env","stateFile":"/var/lib/alexgetman-media-processor/state.json","healthUrl":"http://127.0.0.1:9087/health","container":"studio-media-processor","service":"media-processor","imageEnvKey":"MEDIA_PROCESSOR_IMAGE","configCheck":false}}
