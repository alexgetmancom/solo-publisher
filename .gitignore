# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# OS Files
.DS_Store
Thumbs.db

# Local editor and backup files
*.bak
*.tmp
*.swp
*.swo
.obsidian/

# Runtime dynamic files and secrets
# Running from source reads it into the environment (docs/install.md).
/secrets.env
/*.db
/*.db-wal
/*.db-shm
/*.zip

# Local static files that are generated dynamically on server (root only)
/feed.json
/feed.xml
/sitemap.xml
/robots.txt
/llms.txt
/posts/
/media/

# Node.js
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
package-lock.json
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.production
.env.*
!.env.example
!.env.*.example

# Local SQLite runtime artifacts and misc junk
*.db
*.db-shm
*.db-wal
*.zip


# Production database snapshots pulled down by hand. Out of the repo root so a
# careless cleanup there cannot reach them; nothing in the project reads them.
/.local-data/

# Scratch output from local tooling
/tmp/
/output/

# Rust build output (the default cargo target directory)
/target/
