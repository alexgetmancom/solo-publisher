# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# OS Files
.DS_Store
Thumbs.db

# Local editor and backup files
*.bak
*.tmp
*.swp
*.swo
.obsidian/

# Runtime dynamic files and secrets
/apps/backend/secrets.env
/apps/backend/secrets.*
# The template is not a secret and both READMEs tell people to copy it, which
# they cannot do while the pattern above swallows it too.
!/apps/backend/secrets.env.example
/apps/backend/site-feed.env
/apps/backend/data/
/apps/backend/logs/
/apps/backend/media-cache/
/apps/backend/*.sqlite
/apps/backend/*.sqlite3
/apps/backend/*.db
/*.db
/*.db-wal
/*.db-shm
/*.zip

# Local static files that are generated dynamically on server (root only)
/feed.json
/feed.xml
/sitemap.xml
/robots.txt
/llms.txt
/posts/
/media/

# Node.js
node_modules/
dist/
# The bundles CI builds from the backend entry points.
# Reproducing the image build locally creates them here too; untracked minified
# bundles are one `git add -A` away from being committed.
/runtime/
/ops/
/entrypoint/
/story-renderer/
/smoke/
*.tsbuildinfo
npm-debug.log*
package-lock.json
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.production
.env.*
!.env.example
!.env.*.example

# Local SQLite runtime artifacts and misc junk
*.db
*.db-shm
*.db-wal
*.zip

# Local dev fixture data (bun scripts/dev-seed.ts)
/.dev-fixture/

# Production database snapshots pulled down by hand. Out of the repo root so a
# careless cleanup there cannot reach them; nothing in the project reads them.
/.local-data/

# Scratch output from local tooling
/tmp/
/output/
